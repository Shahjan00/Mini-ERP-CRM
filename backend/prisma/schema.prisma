// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

enum MovementType {
  IN
  OUT
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(SALES)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

model Customer {
  id          String                  @id @default(uuid())
  name        String
  email       String?                 @unique
  mobile      String?
  businessName String?
  gstNumber   String?
  customerType CustomerType           @default(RETAIL)
  address     String?
  status      CustomerStatus          @default(LEAD)
  followUpDate DateTime?
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  salesChallans SalesChallan[]
  followUpNotes CustomerFollowUpNote[]

  @@index([email])
  @@map("customers")
}

model CustomerFollowUpNote {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  note        String
  followUpDate DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@map("customer_follow_up_notes")
}

model Product {
  id              String        @id @default(uuid())
  name            String
  sku             String        @unique
  description     String?
  category        String
  unitPrice       Decimal       @db.Decimal(10, 2)
  currentStock    Int           @default(0)
  minimumStock    Int           @default(0)
  warehouseLocation String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  stockMovements    StockMovement[]
  salesChallanItems SalesChallanItem[]

  @@index([sku])
  @@map("products")
}

model StockMovement {
  id            String       @id @default(uuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  salesChallanId String?
  salesChallan  SalesChallan? @relation(fields: [salesChallanId], references: [id], onDelete: Cascade)
  movementType  MovementType
  quantity      Int
  reason        String
  createdBy     String
  createdAt     DateTime     @default(now())

  @@index([productId])
  @@index([movementType])
  @@map("stock_movements")
}

model SalesChallan {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  challanNumber String  @unique
  totalQuantity Int
  totalAmount   Decimal  @db.Decimal(12, 2)
  status       ChallanStatus @default(DRAFT)
  createdBy    String
  createdDate  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items SalesChallanItem[]
  stockMovements StockMovement[]

  @@index([customerId])
  @@index([challanNumber])
  @@map("sales_challans")
}

model SalesChallanItem {
  id              String      @id @default(uuid())
  salesChallanId  String
  salesChallan    SalesChallan @relation(fields: [salesChallanId], references: [id], onDelete: Cascade)
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  productNameSnapshot String
  skuSnapshot     String
  unitPriceSnapshot Decimal   @db.Decimal(10, 2)
  quantity        Int
  totalPrice      Decimal   @db.Decimal(12, 2)

  @@index([salesChallanId])
  @@index([productId])
  @@map("sales_challan_items")
}
